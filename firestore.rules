rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Open access: anyone who has the website link can read and edit the ledger.
    // (No sign-in. Data lives in this Firebase project, not in anyone's Google account.)
    match /rows/{id} { allow read, write: if true; }
    match /meta/{id} { allow read, write: if true; }
  }
}
